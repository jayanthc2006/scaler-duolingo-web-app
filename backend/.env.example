# All optional - defaults work for local development.
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_USERNAME=alex
AUTO_SEED=1

# Game rules (shown with their defaults)
MAX_HEARTS=5
HEART_REGEN_SECONDS=1800
REFILL_COST_GEMS=100
XP_PER_CORRECT=2
XP_LESSON_COMPLETE=10
GEMS_PER_LESSON=5

# Legendary (timed) challenge (shown with their defaults)
LEGENDARY_SECONDS=60
LEGENDARY_XP=20
LEGENDARY_GEMS=10
LEGENDARY_WRONG_ANSWER_PENALTY_SECONDS=5
